[Unit]
Description=FAN-GO USER FastAPI (gunicorn/uvicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/FANGO_USER
Environment=PYTHONUNBUFFERED=1
# .env 는 database.py 가 WorkingDirectory 기준으로 읽는다.
ExecStart=/home/ec2-user/FANGO_USER/.venv/bin/gunicorn -c deploy/gunicorn_conf.py main:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
